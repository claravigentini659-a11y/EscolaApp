<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F2F5FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESCOLA APP"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#193B68"
        android:layout_marginBottom="35dp"/>

    <Button
        android:id="@+id/btnDisciplinas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Disciplinas"/>

    <Button
        android:id="@+id/btnAlunos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alunos"/>

    <Button
        android:id="@+id/btnNotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notas do aluno"/>

    <Button
        android:id="@+id/btnMatriculas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Matrículas do aluno"/>

</LinearLayout>
